# Copy this file to server/.env and fill in your own values.
# server/.env is in .gitignore, so your keys never get committed.
# Leave the Twilio lines empty to only print texts (fine for testing).

# Twilio: use either an auth token, or an API key and secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# The Twilio number texts come from, like +15875550100
TWILIO_FROM=

# Name used in the texts, like "Primel's apartment"
HOME_NAME=
# 1.0 = real waits, 0.2 = 5x faster for demos
TIME_SCALE=1.0
