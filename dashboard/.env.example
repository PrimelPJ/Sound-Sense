# Copy this file to dashboard/.env and fill in your own values.
# dashboard/.env is in .gitignore, so your keys never get committed.
# Leave the Twilio lines empty to only print texts (fine for testing).

# Twilio: use either the auth token, or an API key and secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# The Twilio number texts come from, like +15875550100
TWILIO_FROM=

# Name used on the dashboard and in texts
HOME_NAME=
# Seconds before backup contacts are texted
ESCALATE_AFTER=60
